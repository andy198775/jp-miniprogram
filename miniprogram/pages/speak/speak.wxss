.container { padding: 24rpx; }
.topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.back { color: #FF8C42; font-size: 30rpx; font-weight: 600; }
.mode { font-size: 24rpx; color: #888; background: #fff; padding: 8rpx 18rpx; border-radius: 30rpx; }

.target-card { text-align: center; padding: 48rpx 24rpx; }
.type-label { font-size: 26rpx; color: #FF8C42; margin-bottom: 12rpx; }
.target { font-size: 140rpx; font-weight: 700; color: #2b2b2b; line-height: 1.2; }
.roma { font-size: 40rpx; color: #999; margin-top: 8rpx; letter-spacing: 2rpx; }
.btn-demo { margin-top: 32rpx; background: #FFE8D6; color: #FF8C42; border: none; border-radius: 40rpx; font-size: 32rpx; }

.record-card { text-align: center; padding: 40rpx 24rpx; margin-top: 24rpx; }
.mic-btn {
  width: 200rpx; height: 200rpx; border-radius: 50%;
  background: linear-gradient(135deg, #FF8C42, #FF6B35);
  color: #fff; font-size: 80rpx; line-height: 200rpx; text-align: center;
  margin: 0 auto; box-shadow: 0 10rpx 30rpx rgba(255,107,53,.35);
}
.mic-btn.recording { animation: pulse 1s infinite; background: linear-gradient(135deg, #ff5252, #d50000); }
.mic-tip { font-size: 26rpx; line-height: 1; margin-top: -30rpx; }
@keyframes pulse { 0%{transform:scale(1)} 50%{transform:scale(1.08)} 100%{transform:scale(1)} }

.result-card { margin-top: 24rpx; text-align: center; padding: 36rpx 24rpx; }
.verdict { font-size: 44rpx; font-weight: 700; }
.verdict.ok { color: #2e9e5b; }
.verdict.no { color: #FF6B35; }
.verdict.neutral { color: #555; }
.msg { font-size: 30rpx; color: #555; margin-top: 16rpx; }
.manual-row { display: flex; gap: 20rpx; margin-top: 28rpx; }
.manual-row .btn-ghost { flex: 1; }
.playback-row { margin-top: 20rpx; }

.btn-primary {
  margin-top: 28rpx; background: #FF8C42; color: #fff; border: none; border-radius: 44rpx;
  font-size: 34rpx; padding: 22rpx 0;
}
.btn-ghost {
  background: #fff; color: #FF8C42; border: 2rpx solid #FFD8BE; border-radius: 40rpx; font-size: 30rpx;
}
.subtitle { font-size: 26rpx; color: #999; }
.center { text-align: center; }
