.weekdays, .grid {
  display: flex;
  flex-wrap: wrap;
}
.wd {
  width: 14.28%;
  text-align: center;
  color: #9b8579;
  font-size: 26rpx;
  padding: 10rpx 0;
}
.cell {
  width: 14.28%;
  height: 96rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}
.cell.empty { visibility: hidden; }
.cell.done { background: #FFE9D6; color: #FF8C42; font-weight: 700; }
.cell.sel { border: 3rpx solid #FF8C42; }
.dot {
  font-size: 16rpx;
  color: #FF8C42;
  margin-top: 4rpx;
}
