<!-- 复习进行中（题型多样化：与 learn 页共用 quiz.js 生成器） -->
<view class="container" wx:if="{{!result}}">
  <view class="subtitle">复习 {{idx + 1}} / {{total}}</view>

  <view class="card center">
    <!-- 听音题：大喇叭 -->
    <block wx:if="{{q.type === 'listen-cn' || q.type === 'listen-kana'}}">
      <view class="audio-big" bindtap="playAudio">🔊</view>
      <view class="subtitle">点一下，听发音</view>
    </block>
    <!-- 看词题：显示假名/汉字 -->
    <block wx:elif="{{q.showWord}}">
      <view class="kana">{{q.word.kana}}</view>
      <view class="subtitle" wx:if="{{q.word.kanji}}">汉字：{{q.word.kanji}}</view>
    </block>
    <!-- 拼假名：缺一个字 -->
    <block wx:elif="{{q.type === 'kana-blank'}}">
      <view class="kana">{{q.blankKana}}</view>
      <view class="subtitle">意思是「{{q.word.cn}}」</view>
    </block>
    <!-- 例句填空 -->
    <block wx:else>
      <view class="sentence">{{q.sentence}}</view>
    </block>
  </view>

  <view class="subtitle center">{{q.ask}}</view>
  <view class="opts">
    <button
      wx:for="{{q.options}}"
      wx:key="*this"
      class="opt {{answered ? (item === q.answer ? 'ok' : (item === picked ? 'no' : '')) : ''}}"
      data-val="{{item}}"
      bindtap="choose"
      disabled="{{answered}}">{{item}}</button>
  </view>

  <view wx:if="{{answered}}" class="center" style="margin-top:16rpx">
    <view class="hl" wx:if="{{correct}}">✅ 答对啦！</view>
    <view wx:else>再试一次，你可以的💪</view>
    <button class="btn-primary" style="margin-top:16rpx" bindtap="next">{{correct ? '下一个' : '再试一次'}}</button>
  </view>
</view>

<!-- 空状态 -->
<view class="container center" wx:elif="{{result.empty}}">
  <view class="title">暂时没有要复习的词 🎉</view>
  <view class="subtitle">去学点新词，明天再来看复习吧！</view>
  <button class="btn-primary" style="margin-top:30rpx" bindtap="backHome">回到首页</button>
</view>

<!-- 完成总结 -->
<view class="container center" wx:else>
  <view class="title">复习完成！🎉</view>
  <view class="card">
    <view class="row"><text>复习单词</text><text class="hl">{{result.studied}} 个</text></view>
    <view class="row"><text>答对</text><text class="hl">{{result.correct}} 个</text></view>
    <view class="row"><text>本次积分</text><text class="hl">+{{result.earned}}</text></view>
    <view class="row"><text>总积分</text><text class="hl">{{result.points}}</text></view>
    <view class="row"><text>连续打卡</text><text class="hl">{{result.streakCurrent}} 天</text></view>
    <view class="row"><text>累计学会</text><text class="hl">{{result.learnedTotal}} 个</text></view>
  </view>
  <button class="btn-primary" bindtap="backHome">回到首页</button>
</view>

<ach-pop id="achPop" />
