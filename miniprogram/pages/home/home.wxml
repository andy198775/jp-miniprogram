<view class="container">
  <view class="badge" wx:if="{{mode === 'local'}}">🧪 本地试玩模式（无需联网/后端）</view>

  <view class="card row">
    <view>
      <view class="subtitle">我的积分</view>
      <view class="title hl">{{points}}</view>
    </view>
    <view style="text-align:right">
      <view class="subtitle">连续打卡</view>
      <view class="title hl">{{streakCurrent}} 天</view>
    </view>
  </view>

  <!-- 学习课程入口 -->
  <view class="card">
    <view class="title">学习课程</view>
    <view class="subtitle">建议先从「五十音图」开始，熟悉拼读后再进入 N5 词汇 👇</view>
    <view class="courses">
      <view class="course" bindtap="goKana">
        <view class="c-emoji">🔤</view>
        <view class="c-name">五十音图</view>
        <view class="c-prog">已掌握 {{kanaMastered}}/{{kanaTotal}}</view>
      </view>
      <view class="course {{kanaReady ? '' : 'locked'}}" bindtap="goLearn">
        <view class="c-emoji">📚</view>
        <view class="c-name">N5 词汇</view>
        <view class="c-prog">{{kanaReady ? '已解锁 ✅' : '先学完五十音图 🔒'}}</view>
      </view>
      <view class="course" bindtap="goPhrase">
        <view class="c-emoji">💬</view>
        <view class="c-name">常用语</view>
        <view class="c-prog">已会 {{phraseLearned}}/{{phraseTotal}}</view>
      </view>
      <view class="course" bindtap="goSpeak">
        <view class="c-emoji">🎤</view>
        <view class="c-name">跟我读</view>
        <view class="c-prog">开口说日语</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="title">今日任务</view>
    <view class="subtitle" wx:if="{{todayDone}}">✅ 今天已经学过啦，可以继续复习或再学一轮</view>
    <view class="subtitle" wx:else>新词 {{newCount}} 个 · 复习 {{reviewCount}} 个</view>
    <button class="btn-primary" style="margin-top:20rpx" bindtap="goStart">开始学习</button>
    <button class="btn-ghost" style="margin-top:16rpx" bindtap="goReview" wx:if="{{reviewCount > 0}}">📝 复习 {{reviewCount}} 个</button>
  </view>

  <view class="card row">
    <button class="btn-ghost" style="flex:1;margin-right:12rpx" bindtap="goCalendar">📅 学习日历</button>
    <button class="btn-ghost" style="flex:1;margin-left:12rpx" bindtap="goProfile">👤 我的</button>
  </view>

  <view class="subtitle center">已学会 {{learnedTotal}} 个词 · 最长连续 {{streakLongest}} 天</view>
</view>
