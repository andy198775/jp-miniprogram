/* app.wxss 全局样式 */
page {
  background: #FFF7ED;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #3A2E25;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 140, 66, 0.12);
}

/* 主按钮 */
.btn-primary {
  background: #FF8C42;
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
  padding: 22rpx 0;
  text-align: center;
  border: none;
}
.btn-primary::after { border: none; }

.btn-ghost {
  background: #fff;
  color: #FF8C42;
  border: 2rpx solid #FF8C42;
  border-radius: 999rpx;
  font-size: 30rpx;
  padding: 18rpx 0;
  text-align: center;
}

/* 文本 */
.title { font-size: 40rpx; font-weight: 700; }
.subtitle { font-size: 28rpx; color: #9b8579; }
.hl { color: #FF8C42; font-weight: 700; }

.row { display: flex; align-items: center; justify-content: space-between; }
.center { text-align: center; }
