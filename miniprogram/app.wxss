/* app.wxss 全局样式 */
page {
  background: #FFF7ED;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  color: #3A2E25;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 140, 66, 0.12);
}

/* 主按钮 */
.btn-primary {
  background: #FF8C42;
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
  padding: 22rpx 0;
  text-align: center;
  border: none;
}
.btn-primary::after { border: none; }

.btn-ghost {
  background: #fff;
  color: #FF8C42;
  border: 2rpx solid #FF8C42;
  border-radius: 999rpx;
  font-size: 30rpx;
  padding: 18rpx 0;
  text-align: center;
}

/* 文本 */
.title { font-size: 40rpx; font-weight: 700; }
.subtitle { font-size: 28rpx; color: #9b8579; }
.hl { color: #FF8C42; font-weight: 700; }

.row { display: flex; align-items: center; justify-content: space-between; }
.center { text-align: center; }

/* 本地试玩模式标识 */
.badge {
  display: inline-block;
  background: #FFE8D6;
  color: #FF8C42;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  margin-bottom: 20rpx;
}

/* 学习卡：日语假名大字 */
.kana { font-size: 64rpx; font-weight: 700; color: #3A2E25; letter-spacing: 2rpx; }

/* 选项按钮 */
.opts { display: flex; flex-direction: column; }
.opt {
  background: #FFF3E6;
  color: #3A2E25;
  border-radius: 18rpx;
  padding: 24rpx;
  margin: 12rpx 0;
  font-size: 32rpx;
  border: none;
  width: 100%;
  text-align: center;
}
.opt.ok { background: #D7F5DD; color: #1E7E34; }
.opt.no { background: #FBD9D6; color: #C0392B; }

/* 成就 */
.ach { background: #FFF3E6; border-radius: 16rpx; padding: 18rpx 22rpx; margin: 14rpx 0; opacity: 0.55; }
.ach.got { opacity: 1; border: 2rpx solid #FF8C42; }

/* 首页课程入口 */
.courses { display: flex; margin-top: 16rpx; }
.course {
  flex: 1;
  background: #FFF3E6;
  border-radius: 18rpx;
  padding: 22rpx 10rpx;
  margin: 0 8rpx;
  text-align: center;
}
.course:first-child { margin-left: 0; }
.course:last-child { margin-right: 0; }
.course.locked { opacity: 0.55; }
.c-emoji { font-size: 48rpx; }
.c-name { font-size: 28rpx; font-weight: 600; margin-top: 8rpx; color: #3A2E25; }
.c-prog { font-size: 22rpx; color: #9b8579; margin-top: 6rpx; }
.ach-name { font-size: 30rpx; font-weight: 600; }

